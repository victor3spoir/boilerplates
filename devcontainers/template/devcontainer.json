{
  "name": "devcontainer",
  "image": "mcr.microsoft.com/devcontainers/base:dev",
  "workspaceFolder": "/workspaces/app",
  "postCreateCommand": "echo ready",
  "postStartCommand": "echo started",
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {}
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/nils-geistmann/devcontainers-features/zsh:0": {
      "setLocale": true,
      "theme": "robbyrussell",
      "plugins": "git docker",
      "desiredLocale": "en_US.UTF-8 UTF-8"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "pnpmVersion": "latest",
      "nvmVersion": "latest"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0",
      "tabCompletions": true,
      "dotnetRuntimeVersions": "latest, lts",
      "aspNetCoreRuntimeVersions": "latest, lts"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "",
      "optimize": true,
      "installTools": true,
      "toolsToInstall": "pytest"
    },
    "ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {
      "shellautocompletion": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers-extra/features/bun:1":{
      "version": "latest"
    }
  },
  "remoteUser": "app",
  "containerUser": "root",
    "mounts": [
      "source=${localEnv:HOME}/.ssh,target=/home/vscode/,type=bind,readonly"
    ]
}