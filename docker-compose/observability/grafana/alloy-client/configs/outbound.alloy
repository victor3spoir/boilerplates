loki.write "outbound" {
    endpoint {
        url = "http://alloy-srv:3100/loki/api/v1/push"
    }
    // basic_auth {
    //   username = sys.env("USERNAME")
    //   password = sys.env("PASSWORD")
    // }
}


prometheus.remote_write "outbound" {
  endpoint {
    url = "http://alloy-srv:9090/api/v1/metrics/write"
    headers = {
      "X-Scope-OrgId" = "demo",
    }
    // basic_auth {
    //   username = sys.env("MIMIR_USER")
    //   password = sys.env("MIMIR_PASSWORD")
    // }
  }
}

otelcol.exporter.otlp "outbound" {
   client {
    endpoint = "alloy-srv:4317"
    tls {
      insecure = true
    }
}
}


otelcol.exporter.otlphttp "outbound" {
   client {
    endpoint = "alloy-srv:4318"
    tls {
      insecure = true
    }
}
}



