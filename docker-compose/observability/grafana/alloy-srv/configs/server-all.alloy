livedebugging {
  enabled = true
}


pyroscope.receive_http "inbound" {
  http {
       listen_address = "0.0.0.0"
       listen_port = 9999
   }
   forward_to = [pyroscope.write.pyroscope.receiver]
}

otelcol.receiver.otlp "inbound" {
    grpc {
      endpoint = "0.0.0.0:4317"
      // auth = otelcol.auth.basic.creds.handler
    }
    http {
      endpoint = "0.0.0.0:4318"
      // auth = otelcol.auth.basic.creds.handler
    }
    output {
      metrics = [otelcol.processor.batch.otlp.input]
      logs    = [otelcol.processor.batch.otlp.input]
      traces  = [otelcol.processor.batch.otlp.input]
  }
}

prometheus.receive_http "inbound" {
  // accept: /api/v1/metrics/write
  http {
    listen_address = "0.0.0.0"
    listen_port = 9090
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

loki.source.api "inbound" {
    http {
        listen_address = "0.0.0.0"
        listen_port = "3100"
    }
    forward_to = [loki.write.loki_srv.receiver]
}

otelcol.processor.batch "otlp" {
  output {
      metrics = [otelcol.exporter.prometheus.otlp_metrics.input]
      logs    = [otelcol.exporter.loki.otlp_logs.input]
      traces  = [otelcol.exporter.otlp.tempo.input]
    }
}


otelcol.exporter.loki "otlp_logs" {
  forward_to = [
    loki.write.loki_srv.receiver,
  ]
}


otelcol.exporter.prometheus "otlp_metrics" {
  forward_to = [
    prometheus.remote_write.mimir.receiver,
    prometheus.remote_write.prometheus.receiver,
  ]
}

loki.write "loki_srv" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
    }
}


prometheus.remote_write "mimir" {
  endpoint {
    url = "https://mimir.localhost/api/v1/push"
    headers = {
      "X-Scope-OrgId" = "demo",
    }
    // basic_auth {
    //   username = sys.env("MIMIR_USER")
    //   password = sys.env("MIMIR_PASSWORD")
    // }
  }
}

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
    // basic_auth {
    //   username = sys.env("PROMETHEUS_USER")
    //   password = sys.env("PROMETHEUS_PASSWORD")
    // }
  }
}



pyroscope.write "pyroscope" {
   endpoint {
       url = "http://pyroscope:4040"
   }
}

otelcol.exporter.otlp "tempo" {
   client {
    endpoint = "https://tempo.localhost"
    tls {
      insecure = true
    }
}
}
