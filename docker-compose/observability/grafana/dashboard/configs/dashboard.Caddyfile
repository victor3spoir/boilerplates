{
    admin off
}

:80 {
    reverse_proxy {
        to grafana-01:3000 grafana-02:3000 
        health_path /api/health
        health_interval 5s
        health_timeout 2s
        lb_policy first
        fail_duration 10s
        max_fails 1
        transport http {
            read_timeout 5s
            write_timeout 10s
            dial_timeout 5s
            keepalive 30s
        }
    }
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        -Server
    }
    
}
